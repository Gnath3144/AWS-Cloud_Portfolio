# Admin Secret Key (Generate a strong 32+ character random key for authorizing Admin Dashboard operations)
ADMIN_API_KEY=your_secure_random_admin_api_key_here

# Database Storage Path
DATABASE_CSV_PATH=database/leads.csv

# SMTP Notification Settings (Set SMTP_ENABLED=true to send live emails)
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
NOTIFICATION_RECIPIENT_EMAIL=gnath3144@gmail.com

# Rate Limiting (5 requests per 60 seconds per IP)
RATE_LIMIT_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=60
